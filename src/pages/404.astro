---
import Base from '../layouts/Base.astro';
---
<Base title="No encontramos esa página">
  <section class="hero dark">
    <div class="container">
      <p class="eyebrow">Error 404</p>
      <h1 class="display">No encontramos esa <em>página</em></h1>
      <p class="lede">Puede que el enlace haya cambiado. Vuelve al inicio y busca desde ahí.</p>
      <div class="btn-row"><a class="btn btn-light" href="/">Ir al inicio</a></div>
    </div>
  </section>
</Base>
