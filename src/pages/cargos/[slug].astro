---
import Base from '../../layouts/Base.astro';
import { getCargos } from '../../lib/cargos.js';

export function getStaticPaths() {
  const cargos = getCargos();
  return cargos.map((c, i) => ({
    params: { slug: c.slug },
    props: { cargo: c, anterior: cargos[i - 1] ?? null, siguiente: cargos[i + 1] ?? null, total: cargos.length },
  }));
}

const { cargo, anterior, siguiente, total } = Astro.props;
const { Content, data } = cargo;
const informes = data.informes ?? [];
const materiales = data.materiales ?? [];
const pad = (n) => String(n).padStart(2, '0');
---
<Base title={`Cargo de ${data.titulo}`} description={data.resumen}>
  <section class="page-hero dark">
    <div class="container">
      <p class="eyebrow"><a href="/cargos">← Todos los cargos</a> · Cargo {pad(data.orden)} de {pad(total)}</p>
      {data.borrador && <span class="badge">Borrador · en redacción</span>}
      <h1 class="display">{data.titulo}</h1>
      <p class="lede">{data.resumen}</p>
    </div>
  </section>

  <section class="section">
    <div class="container cargo-layout">
      <article class="prose">
        <Content />
      </article>

      <aside class="aside-card" aria-labelledby="docs-titulo">
        <h2 id="docs-titulo">Informes y materiales 2026</h2>
        <p>Se abren con tu cuenta UC.</p>
        <h3>Informes</h3>
        {informes.length > 0
          ? <ul>{informes.map((d) => <li><a href={d.url}>{d.titulo}</a></li>)}</ul>
          : <p class="vacio">Aún no hay informes publicados.</p>}
        <h3>Materiales</h3>
        {materiales.length > 0
          ? <ul>{materiales.map((d) => <li><a href={d.url}>{d.titulo}</a></li>)}</ul>
          : <p class="vacio">Aún no hay materiales publicados.</p>}
      </aside>
    </div>

    <div class="container">
      <nav class="pager" aria-label="Otros cargos">
        {anterior ? <a href={`/cargos/${anterior.slug}`}><small>Anterior</small>{anterior.data.titulo}</a> : <span></span>}
        {siguiente ? <a href={`/cargos/${siguiente.slug}`}><small>Siguiente</small>{siguiente.data.titulo}</a> : <span></span>}
      </nav>
    </div>
  </section>
</Base>
