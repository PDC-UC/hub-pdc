---
import Base from '../../layouts/Base.astro';
import TeamsMenu from '../../components/TeamsMenu.astro';
import { getCargos } from '../../lib/cargos.js';
import consejo from '../../data/consejo.json';

export function getStaticPaths() {
  const cargos = getCargos();
  return cargos.map((c, i) => ({
    params: { slug: c.slug },
    props: { cargo: c, anterior: cargos[i - 1] ?? null, siguiente: cargos[i + 1] ?? null, total: cargos.length },
  }));
}

const { cargo, anterior, siguiente, total } = Astro.props;
const { Content, data } = cargo;
const esCoordinacion = cargo.slug === 'coordinacion';
const materiales = data.materiales ?? [];
const pad = (n) => String(n).padStart(2, '0');

// Documentos útiles de la zona de coordinadores. Los enlaces externos se editan en src/data/consejo.json.
const documentos = [
  { titulo: 'Primeras metas 2027', texto: 'Las cuatro primeras metas de cada coordinador o coordinadora.', url: '/consejo/coordinacion/metas-2027' },
  { titulo: 'Documento Fundacional', texto: 'Qué es una pastoral de carrera, su misión, pilares y roles.', url: '/que-son' },
  { titulo: 'Pilares de las pastorales de carrera', texto: 'Encuentro, Vocación y Servicio, explicados.', url: '/que-son#pilares' },
  { titulo: 'Presentación del último consejo 2026', texto: 'El año en cifras, para recorrer con calma.', url: '/recorrido' },
  consejo.enlaces.postulacion,
  consejo.enlaces.aprobacion,
];
---
<Base title={`Cargo de ${data.titulo}`} description={data.resumen}>
  <section class="page-hero dark">
    <div class="container">
      <p class="eyebrow"><a href="/consejo">← Zona de Consejo</a> · Cargo {pad(data.orden)} de {pad(total)}</p>
      <h1 class="display">{data.titulo}</h1>
      <p class="lede">{data.resumen}</p>
      <div class="btn-row zona-acciones">
        <TeamsMenu />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="prose">
        <h2 id="perfil">Perfil del cargo</h2>
        {(data.pilar || data.nuevo) && (
          <p class="acc-tags light">
            {data.pilar && <span class="tag">Pilar · {data.pilar}</span>}
            {data.nuevo && <span class="tag">Cargo nuevo</span>}
          </p>
        )}
        <Content />
      </div>

      {esCoordinacion && (
        <div class="bloque" id="documentos">
          <h2 class="h2">Documentos útiles</h2>
          <p class="lede">Lo que necesitas para llevar tu pastoral. Los enlaces a Teams y Airtable se abren con tu cuenta.</p>
          <div class="accesos">
            {documentos.map((a) =>
              a.url ? (
                <a class="acceso" href={a.url} target={a.url.startsWith('http') ? '_blank' : undefined} rel={a.url.startsWith('http') ? 'noopener' : undefined}>
                  <h3>{a.titulo}</h3>
                  <p>{a.texto}</p>
                  <span class="estado">Abrir →</span>
                </a>
              ) : (
                <div class="acceso pronto">
                  <h3>{a.titulo}</h3>
                  <p>{a.texto}</p>
                  <span class="estado">Próximamente</span>
                </div>
              )
            )}
          </div>
        </div>
      )}

      <div class="bloque" id="materiales">
        <h2 class="h2">Materiales 2026</h2>
        {materiales.length > 0
          ? <ul class="lista-docs">{materiales.map((d) => <li><a href={d.url} target="_blank" rel="noopener">{d.titulo}</a></li>)}</ul>
          : <p class="vacio">Aún no hay materiales publicados para este cargo.</p>}
        <p class="nota">El informe de traspaso 2026 está en la carpeta de tu pastoral en Teams. Entra desde el menú «Teams» de arriba, con tu cuenta UC.</p>
      </div>

      <nav class="pager" aria-label="Otros cargos">
        {anterior ? <a href={`/consejo/${anterior.slug}`}><small>Anterior</small>{anterior.data.titulo}</a> : <span></span>}
        {siguiente ? <a href={`/consejo/${siguiente.slug}`}><small>Siguiente</small>{siguiente.data.titulo}</a> : <span></span>}
      </nav>
    </div>
  </section>
</Base>
