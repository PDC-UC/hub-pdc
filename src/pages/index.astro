---
import Base from '../layouts/Base.astro';
import LogoCard from '../components/LogoCard.astro';
import Arrow from '../components/Arrow.astro';
import pastorales from '../data/pastorales.json';
import { getCargos } from '../lib/cargos.js';

const cargos = getCargos();
const campus = new Set(pastorales.map((p) => p.campus).filter(Boolean));
const conLogo = pastorales.filter((p) => p.logo).slice(0, 11);
const pad = (n) => String(n).padStart(2, '0');
---
<Base>
  <!-- Portada -->
  <section class="hero dark">
    <div class="container">
      <p class="eyebrow">Pastorales de Carrera · Pastoral UC</p>
      <h1 class="display">Una <em>casa común</em> para las pastorales de carrera</h1>
      <p class="lede">Aquí encuentras quiénes somos, cómo sumarte y todo lo que necesitas para llevar un cargo en tu pastoral.</p>
      <div class="btn-row">
        <a class="btn btn-light" href="/como-participar">Quiero participar</a>
        <a class="btn btn-ghost" href="/cargos">Tengo un cargo</a>
      </div>
      <div class="stats">
        <div><div class="stat-n">{pastorales.length}</div><div class="stat-l">pastorales de carrera</div></div>
        <div><div class="stat-n">{campus.size}</div><div class="stat-l">campus</div></div>
        <div><div class="stat-n">{cargos.length}</div><div class="stat-l">cargos con su guía</div></div>
      </div>
    </div>
  </section>

  <!-- Caminos -->
  <section class="section" id="caminos">
    <div class="container">
      <h2 class="h2">¿Qué estás buscando?</h2>
      <p class="lede">Elige el camino que te calce y parte por ahí.</p>
      <div class="cards">
        <a class="card" href="/pastorales">
          <span class="card-n">01</span>
          <span class="card-t">Quiero conocer las pastorales</span>
          <span class="card-p">Encuentra la pastoral de tu carrera, qué hace y cómo sumarte.</span>
          <span class="card-go">Ver las pastorales →</span>
        </a>
        <a class="card" href="/coordinadores">
          <span class="card-n">02</span>
          <span class="card-t">Soy coordinador</span>
          <span class="card-p">Guías, calendario, formularios y rutas para llevar tu pastoral.</span>
          <span class="card-go">Ir a la zona de coordinadores →</span>
        </a>
        <a class="card" href="/cargos">
          <span class="card-n">03</span>
          <span class="card-t">Tengo un cargo en un consejo</span>
          <span class="card-p">Qué hace tu cargo, cómo se vivió este año y los materiales de 2026.</span>
          <span class="card-go">Ver los cargos →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Pared de logos -->
  <section class="section section-soft" id="pastorales">
    <div class="container">
      <div class="head-row">
        <div>
          <h2 class="h2">Las pastorales de carrera</h2>
          <p class="lede">Una por cada carrera. Busca la tuya.</p>
        </div>
        <a class="link-go" href="/pastorales">Ver las {pastorales.length} →</a>
      </div>
      <div class="logo-grid">
        {conLogo.map((p) => <LogoCard p={p} />)}
        <a class="logo-more" href="/pastorales">Ver todas las pastorales →</a>
      </div>
    </div>
  </section>

  <!-- Cargos -->
  <section class="section dark" id="cargos">
    <div class="container">
      <p class="eyebrow">Cargos de los consejos</p>
      <h2 class="h2">Cada cargo tiene su guía</h2>
      <p class="lede">Qué hace, cómo se vive durante el año y los informes y materiales de 2026, todo en un solo lugar.</p>
      <div class="rows">
        {cargos.map((c) => (
          <a class="row" href={`/cargos/${c.slug}`}>
            <span class="row-l"><span class="row-n">{pad(c.data.orden)}</span><span class="row-name">{c.data.titulo}</span></span>
            <Arrow />
          </a>
        ))}
      </div>
      <div class="band" id="coordinadores">
        <div>
          <h3>Zona de coordinadores</h3>
          <p>Guías, calendario, formularios y rutas para llevar tu pastoral. Los documentos internos se abren con tu cuenta UC.</p>
        </div>
        <a class="btn btn-light" href="/coordinadores">Entrar</a>
      </div>
    </div>
  </section>
</Base>
