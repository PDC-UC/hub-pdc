---
import Base from '../layouts/Base.astro';
import data from '../data/accesos.json';
---
<Base title="Zona de coordinadores" description="Guías, calendario, formularios y rutas para coordinadores de las pastorales de carrera.">
  <section class="page-hero dark">
    <div class="container">
      <p class="eyebrow">Para coordinadores</p>
      <h1 class="display">Zona de coordinadores</h1>
      <p class="lede">Todo lo que necesitas para llevar tu pastoral, a un clic. Los documentos se abren con tu cuenta UC.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="accesos" style="margin-top: 0">
        {data.accesos.map((a) =>
          a.url ? (
            <a class="acceso" href={a.url}>
              <h3>{a.titulo}</h3>
              <p>{a.texto}</p>
              <span class="estado">Abrir →</span>
            </a>
          ) : (
            <div class="acceso pronto">
              <h3>{a.titulo}</h3>
              <p>{a.texto}</p>
              <span class="estado">Próximamente</span>
            </div>
          )
        )}
      </div>
      <p class="nota">Si un enlace te pide iniciar sesión, usa tu cuenta UC. Si no puedes entrar, escribe a la coordinación de pastorales de carrera.</p>
    </div>
  </section>
</Base>
