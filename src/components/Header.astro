---
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const enlaces = [
  { href: '/que-son', texto: 'Qué son' },
  { href: '/pastorales', texto: 'Pastorales' },
  { href: '/como-participar', texto: 'Cómo participar' },
  { href: '/preguntas', texto: 'Preguntas' },
  { href: '/recorrido', texto: 'Recorrido' },
];
const activo = (href) => (ruta === href || ruta.startsWith(href + '/') ? 'page' : undefined);
---
<header class="site-header dark">
  <div class="container">
    <a class="logo" href="/" aria-label="Pastoral UC, ir al inicio">
      <img src="/pastoral-uc-blanco.png" alt="Pastoral UC" width="116" height="56" />
    </a>
    <nav class="site-nav" aria-label="Principal">
      {enlaces.map((e) => <a href={e.href} aria-current={activo(e.href)}>{e.texto}</a>)}
      <a class="nav-pill" href="/consejo" aria-current={activo('/consejo')}>Zona de Consejo</a>
    </nav>
  </div>
</header>
